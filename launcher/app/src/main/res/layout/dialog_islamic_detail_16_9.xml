<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="640dp"
    android:layout_height="360dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_islamic_dialog_16_9"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="18dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:baselineAligned="false">

    <!-- Left Column: Hero Meta & Actions (width: 210dp) -->
    <LinearLayout
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top row: Icon Badge + Category Label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dlgDetailIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_islamic_header_badge"
                android:src="@drawable/ic_mosque"
                android:padding="6dp"
                android:contentDescription="Islamic Icon" />

            <TextView
                android:id="@+id/dlgDetailBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.08"
                android:text="KHUTBAH MINBAR"
                android:textAllCaps="true"
                android:textColor="#FF67E8F9"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Main Title -->
        <TextView
            android:id="@+id/dlgDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="15.5sp" />

        <!-- Meta Badge (Date / Zone / Reference) -->
        <TextView
            android:id="@+id/dlgDetailMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_warning_time_pill"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 500"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />

        <!-- Source / Authority -->
        <TextView
            android:id="@+id/dlgDetailSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 400"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Action Buttons -->
        <TextView
            android:id="@+id/btnDlgDetailSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_dlg_btn_cyan_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:text="🔁 Tukar Paparan"
            android:textColor="@color/selector_dlg_btn_cyan_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDlgDetailChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/selector_dlg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:text="📑 Pilihan Kandungan..."
            android:textColor="#E6FFFFFF"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/btnDlgDetailClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/selector_dlg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 500"
            android:text="Tutup"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Vertical Divider Line -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="#1FFFFFFF" />

    <!-- Right Column: Full Content Reader (Scrollable) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top Header: Title & Close "✕" Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.08"
                android:text="KANDUNGAN PENUH"
                android:textAllCaps="true"
                android:textColor="#80FFFFFF"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/btnDlgDetailDismissX"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/selector_btn_circle_subtle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 700"
                android:contentDescription="Tutup" />
        </LinearLayout>

        <!-- Scrollable Reader View -->
        <ScrollView
            android:id="@+id/dlgDetailScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Arabic Verse (Visible in Doa mode) -->
                <TextView
                    android:id="@+id/dlgDetailArabic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiri_quran"
                    android:gravity="end"
                    android:textDirection="rtl"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#FFE082"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <!-- Subtitle / Theme (Visible in Minbar mode) -->
                <TextView
                    android:id="@+id/dlgDetailSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:textColor="#FF67E8F9"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp"
                    android:visibility="gone" />

                <!-- Main Excerpt / Translation Body with Justification -->
                <TextView
                    android:id="@+id/dlgDetailBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 400"
                    android:lineSpacingMultiplier="1.35"
                    android:justificationMode="inter_word"
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>

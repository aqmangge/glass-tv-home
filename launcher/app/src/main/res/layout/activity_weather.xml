<?xml version="1.0" encoding="utf-8"?>
<!-- Designed for a 1920x1080 TV (≈ 960 x 540 dp) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:clickable="false"
    android:background="#0B1020">

    <!-- Animated background (replaces the .png) -->
    <com.gathin.tvhome.WeatherSkyView
        android:id="@+id/skyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- ===== Top: current weather + stats ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/headerBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/chipTemp">

                <TextView
                    android:id="@+id/tvIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛈️"
                    android:textSize="64sp"
                    android:layout_marginEnd="24dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Putrajaya"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26°C"
                        android:textColor="#FFFFFF"
                        android:textSize="76sp"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tvCondition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thunderstorm"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvMaxMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max: 30°C  ·  Min: 25°C"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/statsBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="40dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌡️" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Feels Like" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <TextView android:id="@+id/tvFeels" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="31°C" android:textColor="#FFFFFF" android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="40dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💧" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Rain Chance" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <TextView android:id="@+id/tvRain" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="95%" android:textColor="#FFFFFF" android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⏲️" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pressure" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <TextView android:id="@+id/tvPressure" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="1006hPa" android:textColor="#FFFFFF" android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Hourly forecast card ===== -->
        <LinearLayout
            android:id="@+id/hourlyCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="18dp"
            android:background="@drawable/glass_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📈  Hourly Forecast"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/chipTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="Temperature"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:includeFontPadding="false"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/headerBlock"
                    android:nextFocusDown="@+id/dayRow"
                    android:nextFocusRight="@+id/chipPrecip"
                    android:background="@drawable/chip_selected" />

                <TextView
                    android:id="@+id/chipPrecip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:text="Precipitation"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:includeFontPadding="false"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/headerBlock"
                    android:nextFocusDown="@+id/dayRow"
                    android:nextFocusLeft="@+id/chipTemp"
                    android:nextFocusRight="@+id/chipWind"
                    android:background="@drawable/chip" />

                <TextView
                    android:id="@+id/chipWind"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:text="Wind"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:includeFontPadding="false"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/headerBlock"
                    android:nextFocusDown="@+id/dayRow"
                    android:nextFocusLeft="@+id/chipPrecip"
                    android:background="@drawable/chip" />
            </LinearLayout>

            <com.gathin.tvhome.HourlyChartView
                android:id="@+id/hourlyChart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ===== 5-day cards (filled from MainActivity) ===== -->
        <LinearLayout
            android:id="@+id/dayRow"
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>

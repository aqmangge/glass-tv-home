<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111216"
    android:clipChildren="false">

    <!-- Layer 0: Hardware-Accelerated Dynamic Atmospheric Weather Canvas (Subtle ambient) -->
    <com.gathin.tvhome.WeatherBackgroundView
        android:id="@+id/weatherBgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25" />

    <!-- Main Widescreen TV Content: Zero vertical scroll, fits 1080p/4K TV perfectly -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="52dp"
        android:paddingEnd="56dp"
        android:paddingBottom="38dp">

        <!-- Upper Section: Hero Location/Temp (Left) & RTL Weather Icon/Stats (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Left Hero: Location + Massive Temp + Condition -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:gravity="start|center_vertical"
                android:orientation="vertical">

                <!-- Subtitle: Agora em / Sekarang di -->
                <TextView
                    android:id="@+id/weatherSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 400"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="Agora em"
                    android:textColor="#9CA3AF"
                    android:textSize="17sp" />

                <!-- City / Region Title -->
                <TextView
                    android:id="@+id/weatherLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="São Paulo"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp" />

                <!-- Giant Temperature Display -->
                <TextView
                    android:id="@+id/weatherMainTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 500"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="28°C"
                    android:textColor="#FF4545"
                    android:textSize="72sp" />

                <!-- Condition Phrase -->
                <TextView
                    android:id="@+id/weatherMainCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 400"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="Alguma nebulosidade"
                    android:textColor="#E2E8F0"
                    android:textSize="21sp" />

                <!-- Secondary Sub (High / Low) -->
                <TextView
                    android:id="@+id/weatherMainSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 500"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="Max: 30°C  ·  Min: 21°C"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Right Hero: RTL Animated Weather Illustration + 3 Core Metrics -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="end"
                android:orientation="vertical">

                <!-- RTL Animated Weather Illustration (Lucas Carrascosa Style) -->
                <com.gathin.tvhome.RtlWeatherIconView
                    android:id="@+id/rtlWeatherIcon"
                    android:layout_width="220dp"
                    android:layout_height="125dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="12dp" />

                <!-- 3 Core Metrics (SENSAÇÃO / UMIDADE / PRESSÃO) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Metric 1: Sensação / Feels Like -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="36dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/feelsLikeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:fontVariationSettings="'wght' 700"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.06"
                            android:singleLine="true"
                            android:text="SENSAÇÃO"
                            android:textAllCaps="true"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/feelsLikeVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter"
                            android:fontVariationSettings="'wght' 400"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="29°C"
                            android:textColor="#FF4545"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <!-- Metric 2: Umidade / Humidity -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="36dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/humidityLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:fontVariationSettings="'wght' 700"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.06"
                            android:singleLine="true"
                            android:text="UMIDADE"
                            android:textAllCaps="true"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/humidityValText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter"
                            android:fontVariationSettings="'wght' 400"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="79%"
                            android:textColor="#38BDF8"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <!-- Metric 3: Pressão / Air Quality -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/aqiLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:fontVariationSettings="'wght' 700"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.06"
                            android:singleLine="true"
                            android:text="PRESSÃO"
                            android:textAllCaps="true"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/aqiValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter"
                            android:fontVariationSettings="'wght' 400"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="1017hPa"
                            android:textColor="#FF4545"
                            android:textSize="28sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic vertical spacer giving generous breathing room below hero -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8" />

        <!-- Middle Section: Google Weather Style Smooth Hourly Temperature Curve -->
        <com.gathin.tvhome.HourlyWeatherGraphView
            android:id="@+id/hourlyGraphView"
            android:layout_width="match_parent"
            android:layout_height="82dp" />

        <!-- Dynamic vertical spacer distributing space before bottom forecast cards -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0" />

        <!-- Bottom Section: 5-Day Forecast Cards evenly spaced across widescreen TV -->
        <LinearLayout
            android:id="@+id/dailyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- Invisible Container preserving legacy references for full backwards compatibility -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <View
            android:id="@+id/btnChangeLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:id="@+id/hourlyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.gathin.tvhome.WindCompassView
            android:id="@+id/windCompassView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.gathin.tvhome.MoonPhaseView
            android:id="@+id/moonPhaseView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.gathin.tvhome.SunArcView
            android:id="@+id/sunArcView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.gathin.tvhome.RadarMapView
            android:id="@+id/radarMapView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.gathin.tvhome.PressureGaugeView
            android:id="@+id/pressureGaugeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/sunsetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/uvValText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/uvDescText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/aqiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.gathin.tvhome.AqiSpectrumBarView
            android:id="@+id/aqiBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/aqiStation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/weatherFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Minimalist Daily Forecast Card matching 16:9 Putrajaya Weather Concept -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="116dp"
    android:layout_weight="1"
    android:layout_marginEnd="14dp"
    android:background="@drawable/selector_weather_card_minimal"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Day Header (e.g. Today, Wednesday, Thursday) -->
    <TextView
        android:id="@+id/dailyDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:fontVariationSettings="'wght' 600"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="Today"
        android:textColor="#F5F7FC"
        android:textSize="15.5sp" />

    <!-- Card Bottom Content: Temp Range (Left) & Weather Icon (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal">

        <!-- Temp Stack (↑ Max / ↓ Min) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dailyMaxTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 700"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="↑ 30°C"
                android:textColor="#F5F7FC"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dailyMinTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 400"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="↓ 24°C"
                android:textColor="#A8B5CC"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Weather Icon -->
        <ImageView
            android:id="@+id/dailyIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:src="@drawable/wx_rtl_partly" />
    </LinearLayout>
</LinearLayout>

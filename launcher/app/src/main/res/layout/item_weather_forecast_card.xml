<?xml version="1.0" encoding="utf-8"?>
<!-- Modern TV Weather Forecast Card matching RTL / São Paulo TV UI design -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="126dp"
    android:layout_weight="1"
    android:layout_marginEnd="14dp"
    android:background="@drawable/weather_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Day Header (e.g. Quarta-feira, Isnin, Tuesday) -->
    <TextView
        android:id="@+id/dailyDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:fontVariationSettings="'wght' 500"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="Quarta-feira"
        android:textColor="#A1A1AA"
        android:textSize="14.5sp" />

    <!-- Bottom Content: Left Thermometer Temp Stack + Right Weather Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal">

        <!-- Temp Stack with Thermometer Vectors -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- High Temp with High Thermometer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_temp_high" />

                <TextView
                    android:id="@+id/dailyMaxTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="30°C"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Low Temp with Low Thermometer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_temp_low" />

                <TextView
                    android:id="@+id/dailyMinTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 500"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="21°C"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Weather Icon -->
        <ImageView
            android:id="@+id/dailyIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:src="@drawable/wx_rtl_partly" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#FF000000">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the place's name, its country and what it is about, positioned above the dock in code.
         The width is capped in code to a share of the space between the side paddings, so the
         description wraps in a column instead of running the width of the screen. -->
    <LinearLayout
        android:id="@+id/heroShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.75"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- The country/state close under the name, and the description a little further below it. -->
        <TextView
            android:id="@+id/heroWhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 400"
            android:lineSpacingExtra="2dp"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Right shelf: Waktu Solat Table matching bravia-glass-tv UI -->
    <LinearLayout
        android:id="@+id/islamicShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        android:gravity="end"
        android:alpha="1">

        <!-- Ayat / Doa Harian (WeeklyAyah) matching bravia-glass-tv UI -->
        <LinearLayout
            android:id="@+id/ayahBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:gravity="end"
            android:visibility="gone">

            <TextView
                android:id="@+id/ayahLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOA HARIAN  •  AYAT PILIHAN"
                android:textColor="#CCFFFFFF"
                android:textSize="10.5sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true" />

            <TextView
                android:id="@+id/ayahArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxWidth="400dp"
                android:gravity="end"
                android:textDirection="rtl"
                android:textColor="#FFFFC56B"
                android:textSize="15sp"
                android:fontFamily="@font/amiri_quran"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/ayahText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="400dp"
                android:gravity="end"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 400"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- Waktu Solat Header (e.g. WAKTU SOLAT • 11 JAMADILAWAL 1448H) -->
        <TextView
            android:id="@+id/prayerHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="#B3FFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.12"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <!-- Waktu Solat Table (6 Columns: Subuh, Syuruk, Zohor, Asar, Maghrib, Isyak) -->
        <LinearLayout
            android:id="@+id/prayerTable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Subuh -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="0dp">
                <TextView
                    android:id="@+id/lblSubuh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subuh"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeSubuh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Syuruk -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblSyuruk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Syuruk"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeSyuruk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Zohor -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblZohor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zohor"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeZohor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Asar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblAsar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asar"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeAsar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblMaghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maghrib"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeMaghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Isyak -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblIsyak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Isyak"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeIsyak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top Row: Clock & Date on Left, Menu Buttons on Right (SEBARIS DENGAN MASA) -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="56sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="-0.03"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:includeFontPadding="false" />

                <!-- 1:2 layout: 1 jam on left, 2 stacked rows on right (atas: am/pm, bawah: tarikh) -->
                <LinearLayout
                    android:id="@+id/dateBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <!-- Atas: AM/PM (e.g. PG / PTG / MLM) -->
                    <TextView
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="0.06"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textAllCaps="true" />

                    <!-- Bawah: Tarikh (e.g. 23 OKT 2026) -->
                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:includeFontPadding="false"
                        android:textColor="#E6FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="0.06"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textAllCaps="true" />

                    <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#E6FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.02"
                        android:includeFontPadding="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bawah Jam: Weather plus Haze API (clickable & focusable pill to open WeatherActivity) -->
            <TextView
                android:id="@+id/weatherAirQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignParentStart="true"
                android:layout_marginTop="8dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/weather_pill_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="5dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 500"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true" />

            <!-- Now Playing Widget Card: Matching bravia-glass-tv design -->
            <LinearLayout
                android:id="@+id/nowPlayingCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_below="@id/weatherAirQuality"
                android:layout_alignParentStart="true"
                android:layout_marginTop="12dp"
                android:focusable="false"
                android:visibility="gone"
                android:background="@drawable/glass_panel"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cardAlbumArt"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_media_app_pill"
                    android:src="@drawable/ic_music"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@+id/cardTrackInfo" />

                <LinearLayout
                    android:id="@+id/cardTrackInfo"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_track_info_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/cardAlbumArt"
                    android:nextFocusRight="@+id/btnInlinePrev">

                    <TextView
                        android:id="@+id/cardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Now playing • SPOTIFY"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.04"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Song Title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever" />
                </LinearLayout>

                <!-- Inline Media Controls: Prev, Play/Pause, Next (Round buttons with ic_np_tint) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnInlinePrev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/cardTrackInfo"
                        android:nextFocusRight="@+id/btnInlinePlayPause" />

                    <ImageView
                        android:id="@+id/btnInlinePlayPause"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_pause"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePrev"
                        android:nextFocusRight="@+id/btnInlineNext" />

                    <ImageView
                        android:id="@+id/btnInlineNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePlayPause"
                        android:nextFocusRight="@+id/btnInlineClose" />

                    <ImageView
                        android:id="@+id/btnInlineClose"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlineNext" />
                </LinearLayout>
            </LinearLayout>

            <!-- Top Menu Buttons: Strictly in the same row, vertically centered with the clock -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/leftBlock"
                android:layout_alignBottom="@id/leftBlock"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopMenuButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopMenuButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/btnAssistant"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="Google Assistant"
                    android:drawableStart="@drawable/ic_mic" />

                <TextView
                    android:id="@+id/btnCandyBox"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="Select User &amp; Child Mode"
                    android:drawableStart="@drawable/ic_shield_child" />

                <FrameLayout
                    android:id="@+id/btnSettingsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopMenuButton"
                        android:layout_width="42dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="0dp"
                        android:drawablePadding="0dp"
                        android:contentDescription="@string/settings"
                        android:drawableStart="@drawable/ic_settings" />

                    <View
                        android:id="@+id/badgeSettingsUpdate"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="3dp"
                        android:visibility="gone"
                        android:background="@drawable/badge_dot_red" />
                </FrameLayout>
            </LinearLayout>

            <!-- Fallback Prayer Times view -->
            <TextView
                android:id="@+id/prayerTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/weatherAirQuality"
                android:layout_alignParentStart="true"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <com.gathin.tvhome.FadeTopFrame
            android:id="@+id/gridWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.gathin.tvhome.FadeTopFrame>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>

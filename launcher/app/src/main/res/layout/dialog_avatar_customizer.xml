<?xml version="1.0" encoding="utf-8"?>
<!-- Glass TV Avatar Color & Expression Customizer Dialog -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="660dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <!-- Dialog Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:text="🎨 Kustomisasi Avatar Watak"
            android:textColor="#FFFFFF"
            android:textSize="21sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter"
            android:text="Pilih ekspresi mimik muka, warna karakter, dan warna latar belakang avatar"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Center: Live Animated Lottie Avatar Preview -->
        <FrameLayout
            android:id="@+id/previewAvatarContainer"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/weather_card_bg"
            android:padding="4dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/previewLottieAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />
        </FrameLayout>

        <!-- Section 1: Character Expressions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:text="Ekspresi Watak (Mimik Muka)"
            android:textColor="#E2E8F0"
            android:textSize="13.5sp" />

        <LinearLayout
            android:id="@+id/containerExpressions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowExpressions1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/rowExpressions2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Section 2: Character Body Color Swatches -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:text="Warna Badan Karakter"
            android:textColor="#E2E8F0"
            android:textSize="13.5sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerCharColors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <!-- Section 3: Background Color Swatches -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:text="Warna Latar Belakang (Latar Avatar)"
            android:textColor="#E2E8F0"
            android:textSize="13.5sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerBgColors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <!-- Action Buttons: Batal & Simpan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelAvatar"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:focusable="true"
                android:fontFamily="@font/inter"
                android:text="Batal"
                android:textColor="#94A3B8" />

            <Button
                android:id="@+id/btnSaveAvatar"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_dialog_btn"
                android:focusable="true"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 600"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Simpan &amp; Terapkan"
                android:textColor="@drawable/dialog_btn_text" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

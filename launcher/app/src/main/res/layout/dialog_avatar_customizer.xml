<?xml version="1.0" encoding="utf-8"?>
<!-- Glass TV Avatar Color Customizer Dialog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="620dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Dialog Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:fontVariationSettings="'wght' 700"
        android:text="🎨 Kustomisasi Avatar Profil"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter"
        android:text="Pilih kombinasi warna karakter dan warna latar belakang avatar anda"
        android:textColor="#94A3B8"
        android:textSize="13.5sp" />

    <!-- Center: Live Animated Lottie Avatar Preview -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/weather_card_bg"
        android:padding="8dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/previewLottieAvatar"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />
    </FrameLayout>

    <!-- Section 1: Background Color Swatches -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:fontVariationSettings="'wght' 600"
        android:text="Warna Latar Belakang (Background)"
        android:textColor="#E2E8F0"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerBgColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <!-- Section 2: Character Color Swatches -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter"
        android:fontVariationSettings="'wght' 600"
        android:text="Warna Karakter (Character)"
        android:textColor="#E2E8F0"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerCharColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <!-- Action Buttons: Simpan & Tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelAvatar"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:text="Batal"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/btnSaveAvatar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_btn"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Simpan &amp; Terapkan"
            android:textColor="@drawable/dialog_btn_text" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Electric blue outline -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#D916243A" />
            <stroke
                android:width="2dp"
                android:color="#38BDF8" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Selected state: Electric blue outline (persistent active day) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#D916243A" />
            <stroke
                android:width="2dp"
                android:color="#38BDF8" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Default state: Translucent dark surface with subtle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A6101928" />
            <stroke
                android:width="1.2dp"
                android:color="#24334A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>

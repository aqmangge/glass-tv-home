<?xml version="1.0" encoding="utf-8"?>
<!-- Soap bubble / Glass rounded card background with subtle specular rim -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#24252D" />
            <stroke
                android:width="2dp"
                android:color="#8038BDF8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1D22" />
            <stroke
                android:width="1.2dp"
                android:color="#26FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

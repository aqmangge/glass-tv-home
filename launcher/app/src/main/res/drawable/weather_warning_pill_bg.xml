<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted dark maroon glass pill for weather warnings -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC661824" />
            <stroke
                android:width="2dp"
                android:color="#38BDF8" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#804D121B" />
            <stroke
                android:width="1.2dp"
                android:color="#80FF6B6B" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>

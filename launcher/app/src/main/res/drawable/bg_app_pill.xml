<?xml version="1.0" encoding="utf-8"?>
<!-- ReactDrops Soap Bubble styled pill -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#3D1A2538" />
    <stroke
        android:width="1dp"
        android:color="#3867E8F9" />
    <corners android:radius="16dp" />
    <padding
        android:left="10dp"
        android:top="4dp"
        android:right="12dp"
        android:bottom="4dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback for the top-bar pills; MainActivity swaps in GlassDrawable, which adds live blur.
     ReactDrops Soap Bubble style: translucent liquid glass with thin-film iridescent rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#B30E1726"
                android:endColor="#D9080E1A" />
            <stroke android:width="2dp" android:color="#FF67E8F9" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#14101A29" />
            <stroke android:width="1dp" android:color="#3D67E8F9" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>

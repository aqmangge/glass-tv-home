<?xml version="1.0" encoding="utf-8"?>
<!-- Modern TV Weather Forecast Card background matching RTL / São Paulo TV UI design -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A2D36" />
            <stroke
                android:width="2dp"
                android:color="#FF67E8F9" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F2025" />
            <stroke
                android:width="1dp"
                android:color="#2B2D36" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>

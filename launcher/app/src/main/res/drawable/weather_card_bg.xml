<?xml version="1.0" encoding="utf-8"?>
<!-- ReactDrops Soap Bubble styled weather metric card -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#59203A60"
                android:endColor="#4413243D" />
            <stroke
                android:width="2dp"
                android:color="#FF67E8F9" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33142236"
                android:endColor="#240D1726" />
            <stroke
                android:width="1.2dp"
                android:color="#3367E8F9" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
